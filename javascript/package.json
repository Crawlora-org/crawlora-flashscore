{
  "name": "@crawlora-org/flashscore",
  "version": "0.3.6",
  "description": "Crawlora Flashscore API client with 54 endpoints for scores, match details, competitions, teams, players, odds, and news",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=flashscore-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-flashscore/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "flashscore", "flashscore-api", "flashscore-scraper", "flashscore-data", "flashscore-scores", "flashscore-match-details", "flashscore-competitions", "flashscore-teams", "flashscore-players", "flashscore-odds", "flashscore-news"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-flashscore",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
